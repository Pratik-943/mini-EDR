[Unit]
Description=mini-EDR central server
Documentation=https://github.com/Pratik-943/mini-EDR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mini-edr
Group=mini-edr
WorkingDirectory=/opt/mini-edr
EnvironmentFile=/etc/mini-edr/server.env
ExecStart=/opt/mini-edr/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/mini-edr

[Install]
WantedBy=multi-user.target
